{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aippt-studio:schema:aippt-bridge-capabilities:v1",
  "title": "AIPPT bridge capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "created_at",
    "source_surface",
    "source_revision",
    "operations",
    "bridge_mode",
    "connected_apps",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "aippt-bridge-capabilities-v1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_surface": {
      "const": "chatgpt-powerpoint"
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "revision",
        "state",
        "evidence"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "enum": [
            "observed",
            "unavailable"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "observed",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_active_slide",
        "edit_text",
        "edit_geometry",
        "render_page",
        "save_reopen_pptx",
        "export_or_inspect_pdf",
        "animation_playback",
        "transmit_handoff"
      ],
      "properties": {
        "read_active_slide": {
          "$ref": "#/$defs/operation"
        },
        "edit_text": {
          "$ref": "#/$defs/operation"
        },
        "edit_geometry": {
          "$ref": "#/$defs/operation"
        },
        "render_page": {
          "$ref": "#/$defs/operation"
        },
        "save_reopen_pptx": {
          "$ref": "#/$defs/operation"
        },
        "export_or_inspect_pdf": {
          "$ref": "#/$defs/operation"
        },
        "animation_playback": {
          "$ref": "#/$defs/operation"
        },
        "transmit_handoff": {
          "$ref": "#/$defs/operation"
        }
      }
    },
    "bridge_mode": {
      "enum": [
        "direct_bridge",
        "manual_packet",
        "isolated_session"
      ]
    },
    "connected_apps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "confirmed",
            "unavailable",
            "not_attempted",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "confirmed",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "bridge_mode": {
            "const": "direct_bridge"
          }
        }
      },
      "then": {
        "properties": {
          "connected_apps": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
