{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aippt-studio:schema:aippt-expression-review:v1",
  "title": "AIPPT expression review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "created_at",
    "document_revision",
    "review_scope",
    "visual_inspection",
    "observations",
    "adjacent_page_check",
    "preservation_check",
    "invalidated_by_changes",
    "review_state",
    "unverified_limits"
  ],
  "properties": {
    "schema": {
      "const": "aippt-expression-review-v1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "pre_review_revision",
        "reviewed_revision",
        "binding_state",
        "evidence"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Opaque host identifier; never a local path."
        },
        "pre_review_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reviewed_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding_state": {
          "enum": [
            "bound_to_observed_revision",
            "revision_unavailable"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "binding_state": {
                "enum": [
                  "bound_to_observed_revision",
                  "revision_unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "review_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "visual_inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "performed",
            "not_performed",
            "not_comparable"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "performed",
                  "not_comparable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "visible_observation",
          "message_effect",
          "decision",
          "revision_or_reason",
          "evidence"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "visible_observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "message_effect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "decision": {
            "enum": [
              "revised",
              "accepted_as_is",
              "not_revised",
              "needs_user_direction"
            ]
          },
          "revision_or_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1
          }
        }
      }
    },
    "adjacent_page_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "result",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "performed",
            "not_performed",
            "not_comparable"
          ]
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "performed",
                  "not_comparable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "preservation_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence",
        "non_target_slides"
      ],
      "properties": {
        "state": {
          "enum": [
            "performed",
            "not_performed",
            "not_comparable"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "non_target_slides": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "result",
            "evidence"
          ],
          "properties": {
            "state": {
              "enum": [
                "performed",
                "not_performed",
                "not_comparable"
              ]
            },
            "result": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "evidence": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "performed",
                      "not_comparable"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "performed",
                  "not_comparable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "invalidated_by_changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "slide_content_changed",
          "slide_geometry_changed",
          "image_crop_or_mask_changed",
          "theme_or_master_changed",
          "source_content_changed",
          "host_save_or_reopen_changed",
          "unknown_change"
        ]
      }
    },
    "review_state": {
      "enum": [
        "reviewed_current_revision",
        "invalidated_requires_rereview",
        "not_reviewed",
        "not_comparable"
      ]
    },
    "unverified_limits": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_state": {
            "const": "reviewed_current_revision"
          }
        }
      },
      "then": {
        "properties": {
          "document_revision": {
            "properties": {
              "binding_state": {
                "const": "bound_to_observed_revision"
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "visual_inspection": {
            "properties": {
              "state": {
                "const": "performed"
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "invalidated_by_changes": {
            "items": {
              "const": "none"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_state": {
            "const": "invalidated_requires_rereview"
          }
        }
      },
      "then": {
        "properties": {
          "invalidated_by_changes": {
            "items": {
              "enum": [
                "slide_content_changed",
                "slide_geometry_changed",
                "image_crop_or_mask_changed",
                "theme_or_master_changed",
                "source_content_changed",
                "host_save_or_reopen_changed",
                "unknown_change"
              ]
            }
          }
        }
      }
    }
  ]
}
